<?xml version="1.0"?>
<ruleset name="Straumur Payments for WooCommerce">
	<description>Checks run on every pull request. Security and PHP compatibility block merges today; WordPress formatting is added once the existing code has been reformatted.</description>

	<file>./straumur-payments-for-woocommerce.php</file>
	<file>./includes</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Escaping, nonces, input sanitising, safe redirects and prepared SQL. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

	<!-- Code must run on every PHP version readme.txt promises (Requires PHP: 7.4). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
